; ff.v.pica - PICA200 (picasso) port of ff.vert (fixed-function emulation)
;
; Build: picasso -o ff_shbin.shbin ff.v.pica
;        (or via devkitPro's makefile rules: *.v.pica -> ff_shbin.h)
;
; Only the vertex stage lives here. PICA200 has no programmable fragment
; shader, so everything in ff.frag (colorOp, fog, alpha discard) is set up
; with TEV / fog / alpha-test state in ff_pica_setup.c.

; ---- uniforms (each mat4 = 4 consecutive fvec registers, row-major) ----
.fvec modelviewMatrix[4]
.fvec projectionMatrix[4]
.fvec textureMatrix[4]

; ---- constants ----
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; ---- outputs ----
.out outPos position
.out outTc0 texcoord0
.out outClr color

; ---- inputs (must match C3D_AttrInfo order in the setup file) ----
.alias position  v0      ; vec3
.alias texCoords v1      ; vec2
.alias diffuse   v2      ; vec4 (u8 x4, normalized by the hardware)

.entry vmain
.proc vmain
    ; interpTexCoords = (textureMatrix * vec4(texCoords, 1.0, 1.0)).xy;
    mov r0, ones
    mov r0.xy, texCoords
    dp4 r1.x, textureMatrix[0], r0
    dp4 r1.y, textureMatrix[1], r0
    mov outTc0, r1

    ; interpDiffuse = diffuse;
    mov outClr, diffuse

    ; viewCoordinates = modelviewMatrix * vec4(position, 1.0);
    mov r2, ones
    mov r2.xyz, position
    dp4 r3.x, modelviewMatrix[0], r2
    dp4 r3.y, modelviewMatrix[1], r2
    dp4 r3.z, modelviewMatrix[2], r2
    dp4 r3.w, modelviewMatrix[3], r2

    ; gl_Position = projectionMatrix * viewCoordinates;
    dp4 outPos.x, projectionMatrix[0], r3
    dp4 outPos.y, projectionMatrix[1], r3
    dp4 outPos.z, projectionMatrix[2], r3
    dp4 outPos.w, projectionMatrix[3], r3

    ; viewZ varying: dropped. PICA can't pass custom varyings to a fragment
    ; program; fog is computed by the hardware from depth via a fog LUT.

    nop
    end
.end
